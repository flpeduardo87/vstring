rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // AUTH HELPERS
    // Temporarily allowing all access as requested by user ("nao precisa de firebase")
    // to ensure the system is accessible.
    function isSignedIn() {
      return true;
    }

    function isOwner() {
      return true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // VALIDATION BLUEPRINTS

    function isValidCustomer(data) {
      return data.keys().hasAll(['name']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             (data.get('email', '') is string && data.get('email', '').size() <= 200) &&
             (data.get('phone', '') is string && data.get('phone', '').size() <= 50) &&
             (data.get('created_at', null) == null || data.get('created_at', null) is timestamp) &&
             (data.get('updated_at', null) == null || data.get('updated_at', null) is timestamp);
    }

    function isValidInventory(data) {
      return (data.get('description', '') is string) &&
             (data.get('category', 'Corda') in ['Corda', 'Produto']) &&
             (data.get('quantity', 0) is number) &&
             (data.get('price', 0) is number);
    }

    function isValidService(data) {
      return data.keys().hasAll(['customer_id', 'customer_name', 'status', 'racket_model']) &&
             data.customer_id is string &&
             data.customer_name is string && data.customer_name.size() <= 200 &&
             data.status is string &&
             data.racket_model is string && data.racket_model.size() <= 200 &&
             (data.get('service_number', '') is string);
    }

    function isValidSale(data) {
      return data.keys().hasAll(['total', 'items', 'date']) &&
             data.total is number &&
             data.items is list && data.items.size() > 0;
    }

    function isValidRacket(data) {
      return data.keys().hasAll(['brand', 'model']) &&
             data.brand is string && data.brand.size() > 0 && data.brand.size() <= 100 &&
             data.model is string && data.model.size() > 0 && data.model.size() <= 100 &&
             (data.get('string_pattern', '') is string) &&
             (data.get('observations', '') is string) &&
             (data.get('created_at', null) == null || data.get('created_at', null) is timestamp) &&
             (data.get('updated_at', null) == null || data.get('updated_at', null) is timestamp);
    }

    // COLLECTIONS

    match /customers/{customerId} {
      allow read: if isSignedIn();
      allow create: if isOwner() && isValidCustomer(incoming());
      allow update: if isOwner() && isValidCustomer(incoming());
      allow delete: if isOwner();

      match /rackets/{racketId} {
        allow read: if isSignedIn();
        allow create: if isOwner() && isValidRacket(incoming());
        allow update: if isOwner() && isValidRacket(incoming());
        allow delete: if isOwner();
      }
    }

    match /inventory/{itemId} {
      allow read: if isSignedIn();
      allow create: if isOwner() && isValidInventory(incoming());
      allow update: if isOwner() && isValidInventory(incoming());
      allow delete: if isOwner();
    }

    match /services/{serviceId} {
      allow read: if isSignedIn();
      allow create: if isOwner() && isValidService(incoming());
      allow update: if isOwner() && isValidService(incoming());
      allow delete: if isOwner();
    }

    match /sales/{saleId} {
      allow read: if isSignedIn();
      allow create: if isOwner() && isValidSale(incoming());
      allow update: if isOwner() && isValidSale(incoming());
      allow delete: if isOwner();
    }
    
    // Config or settings
    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isOwner();
    }

    match /counters/{docId} {
      allow read, write: if isSignedIn();
    }
  }
}
