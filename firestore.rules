rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // AUTH HELPERS
    // Temporarily allowing all access as requested by user ("nao precisa de firebase")
    // to ensure the system is accessible.
    function isSignedIn() {
      return true;
    }

    function isOwner() {
      return true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // VALIDATION BLUEPRINTS

    function isValidCustomer(data) {
      return data.keys().hasAll(['name']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             (data.get('email', '') is string && data.get('email', '').size() <= 200) &&
             (data.get('phone', '') is string && data.get('phone', '').size() <= 20) &&
             (data.get('racket_model', '') is string && data.get('racket_model', '').size() <= 200);
    }

    function isValidInventory(data) {
      return data.keys().hasAll(['description', 'category', 'quantity', 'price']) &&
             data.description is string && data.description.size() > 0 && data.description.size() <= 300 &&
             data.category is string && data.category in ['Corda', 'Produto'] &&
             data.quantity is number &&
             data.price is number;
    }

    function isValidService(data) {
      return data.keys().hasAll(['customer_id', 'customer_name', 'status', 'racket_model']) &&
             data.customer_id is string && isValidId(data.customer_id) &&
             data.customer_name is string && data.customer_name.size() <= 200 &&
             data.status in ['pendente', 'finalizado'] &&
             data.racket_model is string && data.racket_model.size() <= 200;
    }

    function isValidSale(data) {
      return data.keys().hasAll(['total', 'items', 'date']) &&
             data.total is number &&
             data.items is list && data.items.size() > 0;
    }

    // COLLECTIONS

    match /customers/{customerId} {
      allow read: if isSignedIn();
      allow create: if isOwner() && isValidCustomer(incoming());
      allow update: if isOwner() && isValidCustomer(incoming());
      allow delete: if isOwner();
    }

    match /inventory/{itemId} {
      allow read: if isSignedIn();
      allow create: if isOwner() && isValidInventory(incoming());
      allow update: if isOwner() && isValidInventory(incoming());
      allow delete: if isOwner();
    }

    match /services/{serviceId} {
      allow read: if isSignedIn();
      allow create: if isOwner() && isValidService(incoming());
      allow update: if isOwner() && isValidService(incoming());
      allow delete: if isOwner();
    }

    match /sales/{saleId} {
      allow read: if isSignedIn();
      allow create: if isOwner() && isValidSale(incoming());
      allow update: if isOwner() && isValidSale(incoming());
      allow delete: if isOwner();
    }
    
    // Config or settings
    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isOwner();
    }
  }
}
